APP_ENV=development
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0

# Host ports for docker compose and dev servers (change if already in use)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000
KEYCLOAK_PORT=8080

# Local Keycloak (make infra-up). Dev-only values; real ones come from a secret store.
JWT_ISSUER=http://localhost:8080/realms/opspilot
JWT_AUDIENCE=opspilot-api
OIDC_ISSUER=http://localhost:8080/realms/opspilot
OIDC_CLIENT_ID=opspilot-web
OIDC_CLIENT_SECRET=opspilot-web-dev-only

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=

# Observability on the local kind cluster (make deploy-local)
PROMETHEUS_URL=http://localhost:39090
LOKI_URL=http://localhost:33100
TEMPO_URL=http://localhost:33200

# Client addresses in audit logs.
# API: addresses allowed to send X-Forwarded-For (the web server).
TRUSTED_PROXIES=127.0.0.1
# Web: number of reverse proxies in FRONT of the web server that append
# X-Forwarded-For. 0 locally. Never set it higher than the real number, or a
# browser-supplied header would be trusted.
TRUSTED_PROXY_HOPS=0

KUBERNETES_CONTEXT=kind-opspilot
# Repository-local kubeconfig written by make kind-create (absolute path).
KUBECONFIG=
AGENT_ALLOWED_NAMESPACES=demo
REMEDIATION_ENABLED=false
REQUIRE_REMEDIATION_APPROVAL=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
