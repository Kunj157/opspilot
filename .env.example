APP_ENV=development
DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
REDIS_URL=redis://localhost:6379/0

# Host ports for docker compose and dev servers (change if already in use)
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000
WEB_PORT=3000

JWT_ISSUER=
JWT_AUDIENCE=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=

PROMETHEUS_URL=http://localhost:9090
LOKI_URL=http://localhost:3100
TEMPO_URL=http://localhost:3200

KUBERNETES_CONTEXT=kind-opspilot
REMEDIATION_ENABLED=false
REQUIRE_REMEDIATION_APPROVAL=true

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
