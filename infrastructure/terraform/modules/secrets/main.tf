# Secret containers only. Values are written out of band (or generated by the
# owning service, e.g. RDS-managed passwords) and never appear in Terraform
# state or outputs.

data "aws_caller_identity" "current" {}

data "aws_iam_policy_document" "kms" {
  #checkov:skip=CKV_AWS_356: in a key policy "*" means this key only (the AWS default key policy)
  #checkov:skip=CKV_AWS_109: account administrators manage the key, as in the AWS default key policy
  #checkov:skip=CKV_AWS_111: account administrators manage the key, as in the AWS default key policy
  statement {
    sid       = "AccountAdministration"
    actions   = ["kms:*"]
    resources = ["*"] # a key policy always refers to its own key
    principals {
      type        = "AWS"
      identifiers = ["arn:aws:iam::${data.aws_caller_identity.current.account_id}:root"]
    }
  }
}

resource "aws_kms_key" "this" {
  description             = "${var.name} secrets"
  enable_key_rotation     = true
  deletion_window_in_days = 30
  policy                  = data.aws_iam_policy_document.kms.json
}

resource "aws_kms_alias" "this" {
  name          = "alias/${var.name}-secrets"
  target_key_id = aws_kms_key.this.key_id
}

resource "aws_secretsmanager_secret" "this" {
  #checkov:skip=CKV2_AWS_57: these hold externally issued credentials (OIDC client, model API key) rotated at their issuer; database passwords are RDS-managed and rotate automatically
  for_each                = toset(var.secrets)
  name                    = "${var.name}/${each.key}"
  kms_key_id              = aws_kms_key.this.arn
  recovery_window_in_days = var.recovery_window_in_days
}
