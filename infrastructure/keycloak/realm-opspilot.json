{
  "realm": "opspilot",
  "enabled": true,
  "displayName": "OpsPilot",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "roles": {
    "realm": [
      {
        "name": "viewer",
        "description": "Read services and incidents"
      },
      {
        "name": "operator",
        "description": "Start investigations, manage runbooks"
      },
      {
        "name": "incident-commander",
        "description": "Approve remediation"
      },
      {
        "name": "administrator",
        "description": "Manage users and everything else"
      }
    ]
  },
  "clients": [
    {
      "clientId": "opspilot-api",
      "name": "OpsPilot API (audience only)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "opspilot-web",
      "name": "OpsPilot web",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "opspilot-web-dev-only",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:${WEB_PORT:3000}/auth/callback",
        "http://127.0.0.1:${WEB_PORT:3000}/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:${WEB_PORT:3000}",
        "http://127.0.0.1:${WEB_PORT:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${WEB_PORT:3000}/login?signed_out=1##http://127.0.0.1:${WEB_PORT:3000}/login?signed_out=1"
      },
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "opspilot-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organization",
            "claim.name": "organization",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "opspilot-dev-cli",
      "name": "OpsPilot dev CLI (dev/test only)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "protocolMappers": [
        {
          "name": "api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "opspilot-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "organization",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "organization",
            "claim.name": "organization",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "viewer",
      "enabled": true,
      "emailVerified": true,
      "email": "viewer@acme.example",
      "firstName": "Vera",
      "lastName": "Viewer",
      "attributes": {
        "organization": [
          "acme"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "opspilot-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-opspilot",
        "viewer"
      ]
    },
    {
      "username": "operator",
      "enabled": true,
      "emailVerified": true,
      "email": "operator@acme.example",
      "firstName": "Omar",
      "lastName": "Operator",
      "attributes": {
        "organization": [
          "acme"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "opspilot-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-opspilot",
        "operator"
      ]
    },
    {
      "username": "commander",
      "enabled": true,
      "emailVerified": true,
      "email": "commander@acme.example",
      "firstName": "Cleo",
      "lastName": "Commander",
      "attributes": {
        "organization": [
          "acme"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "opspilot-dev",
          "temporary": false
        }
      ],
      "realmRoles": [
        "default-roles-opspilot",
        "incident-commander"
      ]
    },
    {
      "username": "admin",
      "enabled": true,
      "emailVerified": true,
      "email": "admin@acme.example",
      "firstName": "Ada",
      "lastName": "Admin",
      "attributes": {
        "organization": [
          "acme"
        ]
      },
      "credentials": [
        {
          "type": "password",
